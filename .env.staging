# ARIA Staging Environment Configuration

# Application
APP_NAME=ARIA Emergency Response System (Staging)
APP_VERSION=1.0.0
DEBUG=false
ENVIRONMENT=staging

# Server
HOST=0.0.0.0
PORT=8000
WORKERS=4

# Database
DATABASE_URL=postgresql://aria_user:CHANGEME@staging-db-host:5432/aria_staging
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# Redis
REDIS_URL=redis://staging-redis-host:6379/0

# Security
SECRET_KEY=staging-secret-key-CHANGE-THIS-TO-SECURE-RANDOM-STRING
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS
CORS_ORIGINS=https://staging.aria-emergency.com,https://staging-admin.aria-emergency.com

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000

# OpenAI API
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4-turbo-preview

# Google Maps API
GOOGLE_MAPS_API_KEY=your-google-maps-api-key-here

# Twilio SMS
TWILIO_ACCOUNT_SID=your-twilio-account-sid-here
TWILIO_AUTH_TOKEN=your-twilio-auth-token-here
TWILIO_PHONE_NUMBER=+1234567890

# SendGrid Email
SENDGRID_API_KEY=your-sendgrid-api-key-here
SENDGRID_FROM_EMAIL=staging@aria-emergency.com
SENDGRID_FROM_NAME=ARIA Staging

# OpenWeatherMap
OPENWEATHER_API_KEY=your-openweather-api-key-here

# ML Models
MODEL_PATH=/app/models
ENABLE_ML_PREDICTIONS=true

# Logging
LOG_LEVEL=INFO
LOG_FILE=/var/log/aria/aria_staging.log

# Monitoring
ENABLE_METRICS=true
METRICS_PORT=9090

# Feature Flags
ENABLE_SMS_NOTIFICATIONS=true
ENABLE_EMAIL_NOTIFICATIONS=true
ENABLE_VOICE_TRANSCRIPTION=true
ENABLE_IMAGE_ANALYSIS=true
