# ARIA Development Environment Configuration

# Application
APP_NAME=ARIA Emergency Response System
APP_VERSION=1.0.0
DEBUG=true
ENVIRONMENT=development

# Server
HOST=0.0.0.0
PORT=8000
WORKERS=1

# Database (PostgreSQL with PostGIS)
DATABASE_URL=postgresql://aria_user:aria_password@localhost:5432/aria_dev
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10

# Redis
REDIS_URL=redis://localhost:6379/0

# Security
SECRET_KEY=dev-secret-key-change-in-production-make-it-long-and-random
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000

# Rate Limiting
RATE_LIMIT_PER_MINUTE=100
RATE_LIMIT_PER_HOUR=5000

# OpenAI API (LLM, Whisper, Vision)
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4-turbo-preview

# Google Maps API
GOOGLE_MAPS_API_KEY=your-google-maps-api-key-here

# Twilio SMS
TWILIO_ACCOUNT_SID=your-twilio-account-sid-here
TWILIO_AUTH_TOKEN=your-twilio-auth-token-here
TWILIO_PHONE_NUMBER=+1234567890

# SendGrid Email
SENDGRID_API_KEY=your-sendgrid-api-key-here
SENDGRID_FROM_EMAIL=dev@aria-emergency.local
SENDGRID_FROM_NAME=ARIA Dev

# OpenWeatherMap
OPENWEATHER_API_KEY=your-openweather-api-key-here

# ML Models
MODEL_PATH=./models
ENABLE_ML_PREDICTIONS=true

# Logging
LOG_LEVEL=DEBUG
LOG_FILE=logs/aria_dev.log

# Monitoring
ENABLE_METRICS=true
METRICS_PORT=9090

# Feature Flags
ENABLE_SMS_NOTIFICATIONS=true
ENABLE_EMAIL_NOTIFICATIONS=true
ENABLE_VOICE_TRANSCRIPTION=true
ENABLE_IMAGE_ANALYSIS=true
