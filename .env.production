# ARIA Production Environment Configuration

# Application
APP_NAME=ARIA Emergency Response System
APP_VERSION=1.0.0
DEBUG=false
ENVIRONMENT=production

# Server
HOST=0.0.0.0
PORT=8000
WORKERS=8

# Database
DATABASE_URL=postgresql://aria_user:SECURE_PASSWORD_HERE@prod-db-host:5432/aria_production
DATABASE_POOL_SIZE=30
DATABASE_MAX_OVERFLOW=20

# Redis
REDIS_URL=redis://prod-redis-host:6379/0

# Security
SECRET_KEY=PRODUCTION_SECRET_KEY_MUST_BE_VERY_SECURE_AND_LONG_RANDOM_STRING
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS
CORS_ORIGINS=https://aria-emergency.com,https://admin.aria-emergency.com

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000

# OpenAI API
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4-turbo-preview

# Google Maps API
GOOGLE_MAPS_API_KEY=your-google-maps-api-key-here

# Twilio SMS
TWILIO_ACCOUNT_SID=your-twilio-account-sid-here
TWILIO_AUTH_TOKEN=your-twilio-auth-token-here
TWILIO_PHONE_NUMBER=+1234567890

# SendGrid Email
SENDGRID_API_KEY=your-sendgrid-api-key-here
SENDGRID_FROM_EMAIL=noreply@aria-emergency.com
SENDGRID_FROM_NAME=ARIA Emergency Response

# OpenWeatherMap
OPENWEATHER_API_KEY=your-openweather-api-key-here

# ML Models
MODEL_PATH=/app/models
ENABLE_ML_PREDICTIONS=true

# Logging
LOG_LEVEL=WARNING
LOG_FILE=/var/log/aria/aria_production.log

# Monitoring
ENABLE_METRICS=true
METRICS_PORT=9090

# Feature Flags
ENABLE_SMS_NOTIFICATIONS=true
ENABLE_EMAIL_NOTIFICATIONS=true
ENABLE_VOICE_TRANSCRIPTION=true
ENABLE_IMAGE_ANALYSIS=true
