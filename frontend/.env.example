# ============================================================
# ARIA Frontend — Environment Variables
# Copy this file to .env and fill in your values
# DO NOT commit .env to version control
# ============================================================

# ----- Backend API -----
REACT_APP_API_BASE_URL=http://localhost:8000/api/v1
REACT_APP_WS_URL=ws://localhost:8000/api/v1/ws

# ----- App Meta -----
REACT_APP_APP_NAME=ARIA
REACT_APP_APP_VERSION=1.0.0
REACT_APP_ENV=development

# ----- Maps Configuration -----
# Using OpenStreetMap (Leaflet) — no API key needed
# Optional: If switching to Mapbox or Google Maps, uncomment and add keys:
# REACT_APP_MAPBOX_TOKEN=your_mapbox_token_here
# REACT_APP_GOOGLE_MAPS_KEY=your_google_maps_key_here

# Map defaults (India coordinates)
REACT_APP_MAP_DEFAULT_LAT=20.5937
REACT_APP_MAP_DEFAULT_LNG=78.9629
REACT_APP_MAP_DEFAULT_ZOOM=5

# ----- JWT Configuration -----
REACT_APP_JWT_REFRESH_THRESHOLD=300   # seconds before expiry to auto-refresh

# ----- Feature Flags -----
REACT_APP_ENABLE_ANALYTICS=true
REACT_APP_ENABLE_AI_CHAT=true
REACT_APP_ENABLE_DARK_MODE=true
REACT_APP_ENABLE_RESOURCE_ALLOCATION=true  # ML-powered resource optimization
REACT_APP_ENABLE_VOICE_INPUT=true          # Speech-to-text for incident reporting
REACT_APP_ENABLE_IMAGE_ANALYSIS=true       # Vision AI for injury assessment

# ----- Real-time Updates -----
REACT_APP_WEBSOCKET_RECONNECT_ATTEMPTS=5
REACT_APP_WEBSOCKET_RECONNECT_DELAY=3000   # ms

# ----- UI Configuration -----
REACT_APP_TOAST_DURATION=4000              # ms
REACT_APP_REFRESH_INTERVAL=30000           # ms - auto-refresh dashboard
REACT_APP_MAX_FILE_SIZE=10485760           # bytes (10MB)

# ----- Development -----
REACT_APP_ENABLE_DEBUG_LOGS=false
REACT_APP_MOCK_API=false
