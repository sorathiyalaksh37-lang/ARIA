# Frontend Staging Environment

REACT_APP_API_BASE_URL=https://api-staging.aria-emergency.com
REACT_APP_WS_URL=wss://api-staging.aria-emergency.com/api/v1/ws
REACT_APP_ENVIRONMENT=staging

# Google Maps
REACT_APP_GOOGLE_MAPS_API_KEY=your-google-maps-api-key-here

# Feature Flags
REACT_APP_ENABLE_VOICE_INPUT=true
REACT_APP_ENABLE_IMAGE_UPLOAD=true
REACT_APP_ENABLE_NOTIFICATIONS=true

# Debug
REACT_APP_DEBUG=false
REACT_APP_LOG_LEVEL=info
